/* 
   Project: SQL Data Warehouse from Scratch
   Platform: Google BigQuery
   
   The purpose of this script is to check and create the Medallion 
   architecture datasets (bronze, silver, gold) in Google BigQuery.
*/

-- Create datasets for each layer of the Medallion architecture if they don't already exist
CREATE SCHEMA IF NOT EXISTS `dw-project-sql.bronze`;
CREATE SCHEMA IF NOT EXISTS `dw-project-sql.silver`;
CREATE SCHEMA IF NOT EXISTS `dw-project-sql.gold`;
