CREATE TABLE  `dw-project-sql.bronze.crm_cust_info` 
(
    cst_id INT64, 
    cst_key STRING,
    cst_firstname STRING,
    cst_lastname STRING,
    cst_marital_status STRING,
    cst_gndr STRING,
    cst_create_date DATE
);

