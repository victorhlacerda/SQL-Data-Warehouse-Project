  prd_id INT64,
  prd_key STRING,
  prd_num STRING,
  prd_cost NUMERIC,
  prd_line STRING,
  prd_start_dt DATE, 
  prd_end_dt DATE
);

CREATE TABLE `dw-project-sql.bronze.crm_sales_details` (
  sls_ord_num STRING,
  sls_prd_key STRING,
  sls_cust_id INT64,
  sls_order_dt DATE,
  sls_ship_dt DATE,
  sls_due_dt DATE,
  sls_sales NUMERIC,
  sls_quantity INT64,
  sls_price NUMERIC
);

